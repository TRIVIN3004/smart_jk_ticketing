# ============================================================
# SMART CONTROLS / JK TYRE TICKET SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git!
# ============================================================

# 1. Microsoft SQL Server (SSMS) Connection Settings
DB_SERVER=YOUR_SQL_SERVER_IP
DB_NAME=JKTyre_TicketingDB
DB_USER=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_PORT=1433

# ASP.NET Core Entity Framework Connection String
ConnectionStrings__DefaultConnection="Server=YOUR_SQL_SERVER_IP;Database=JKTyre_TicketingDB;User Id=YOUR_DB_USERNAME;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"

# 2. JWT Authentication Config (.NET 8 Web API)
JWT_SECRET="REPLACE_WITH_YOUR_STRONG_SECRET_KEY"
JWT_ISSUER="JKTyre.Ticketing.Api"
JWT_AUDIENCE="JKTyre.Ticketing.Client"
JWT_EXPIRY_MINUTES=480

# 3. Frontend React Vite Configuration
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_APP_TITLE="SMART CONTROLS — Ticket Management System"
